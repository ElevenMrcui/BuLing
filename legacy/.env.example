# === 数据平面 ===
DATABASE_URL="postgresql://buling:buling@localhost:5432/buling?schema=public"
REDIS_URL="redis://localhost:6379"

# === 服务端口 ===
API_PORT=13500
WEB_PORT=13000

# === 前端调用后端 ===
NEXT_PUBLIC_API_BASE_URL="http://localhost:13500"

# === 安全 ===
# JWT 签名密钥（本地任意长度即可；生产必须 32B+ 随机）
JWT_SECRET="dev-only-change-in-prod"
# Provider API Key 加密主密钥（AES-256-GCM）；生产由 KMS / Vault 注入
PROVIDER_MASTER_KEY_BASE64="ZGV2LW9ubHktMzItYnl0ZS1zZWNyZXQta2V5LWRvLW5vdC11c2U="

# === 观测 ===
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=""  # 留空则不导出
