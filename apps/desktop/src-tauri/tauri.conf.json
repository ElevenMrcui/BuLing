{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "不令 OPC",
  "version": "0.1.0",
  "identifier": "com.buling.opc",
  "build": {
    "beforeDevCommand": "pnpm --filter @buling/desktop dev",
    "beforeBuildCommand": "pnpm --filter @buling/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "不令 OPC",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
