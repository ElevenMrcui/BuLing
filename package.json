{
  "name": "buling",
  "private": true,
  "version": "0.1.0",
  "description": "不令 · 去中心化多智能体协作平台（企业级骨架）",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter='./apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @buling/api prisma:migrate",
    "generate": "pnpm --filter @buling/api prisma:generate"
  }
}
